<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="survey_start_background">#F7F7F5</color>
    <color name="survey_start_staff">#18181B</color>
    <bool name="survey_start_light_bars">true</bool>
    <style name="SurveyLaunchBase" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/survey_start_background</item>
        <item name="android:navigationBarColor">@color/survey_start_background</item>
        <item name="android:windowLightStatusBar">@bool/survey_start_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/survey_start_light_bars</item>
    </style>
    <style name="LaunchTheme" parent="@style/SurveyLaunchBase" />
    <style name="NormalTheme" parent="@style/SurveyLaunchBase">
        <item name="android:windowBackground">@color/survey_start_background</item>
    </style>
</resources>
